/// @dev The list as addresses, in CSV order.
function executorOperators() pure returns (address[] memory ops) {
    bytes memory packed = EXECUTOR_OPERATORS;
    require(packed.length == OPERATOR_COUNT * 20, "operators: the list is not 400 addresses");
    ops = new address[](OPERATOR_COUNT);
    for (uint256 i; i < OPERATOR_COUNT; ++i) {
        address op;
        assembly ("memory-safe") {
            op := shr(96, mload(add(add(packed, 0x20), mul(i, 20))))
        }
        ops[i] = op;
    }
}
